{
  "name": "clinica-unmsm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @clinica/api --filter @clinica/web dev",
    "dev:api": "pnpm --filter @clinica/api dev",
    "dev:web": "pnpm --filter @clinica/web dev",
    "build": "pnpm --filter @clinica/shared build && pnpm --filter @clinica/api build && pnpm --filter @clinica/web build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.13.10",
    "bcrypt": "^5.1.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
